<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="hands_links_joints" params="side reflect">

    <joint name="${side}ForearmJoint" type="fixed">
      <parent link="${side}LowerArm"/>
      <child link="${side}Forearm"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${side}Forearm">
      <xacro:visuals_collisions_hand_section side="${side}" reflect="${reflect}"/>
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>

    <joint name="${side}Wrist" type="revolute">
      <parent link="${side}Forearm"/>
      <child link="${side}Hand"/>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.57" upper="1.57" effort="1.0" velocity="1.0"/>
    </joint>

    <link name="${side}Hand">
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.08"/>
        <inertia ixx="0.0008" ixy="0.0" ixz="0.0" iyy="0.0008" iyz="0.0" izz="0.0008"/>
      </inertial>
    </link>

    <joint name="${side}Gripper" type="revolute">
      <parent link="${side}Hand"/>
      <child link="${side}Gripper"/>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="0.0" upper="0.8" effort="1.0" velocity="1.0"/>
    </joint>

    <link name="${side}Gripper">
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.0005" iyz="0.0" izz="0.0005"/>
      </inertial>
    </link>

  </xacro:macro>

  <!-- Direct test instantiation -->
  <xacro:hands_links_joints side="L" reflect="1"/>
  <!--xacro:hands_links_joints side="R" reflect="-1"/-->

</robot>