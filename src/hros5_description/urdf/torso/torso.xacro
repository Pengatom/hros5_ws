<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
	<!-- DUMMY ROOT LINK -->
	<link name="base_link"/>
	<joint name="fixed-base" type="fixed">
		<parent link="base_link"/>
		<child link="torso"/>
	</joint>
	<!-- TORSO -->
	<link name="torso">
		<xacro:visuals_collisions_torso/>
		<inertial> <!-- Dummy values from Darwin OP -->
			<origin xyz="-0.003053 -0.038651 -0.019268" />
			<mass value="0.97559947"/>
			<!-- Darwin-OP inertia scaled to kg*m^2 (source values were 1000x too large). Real HR-OS5 values: issue #32 -->
			<inertia ixx="0.00310818"  ixy="-0.000254602"  ixz="0.00203182" iyy="0.00637878" iyz="0.000164179" izz="0.00533164" />
		</inertial>
	</link>
</robot>