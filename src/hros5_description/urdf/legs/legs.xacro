<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:macro name="legs_links_joints" params="side reflect">
		<joint name="${side}HipYaw" type="revolute">
			<parent link="torso"/>
			<child link="${side}Hip"/>
			<origin xyz="0.0175 ${reflect*0.048} -0.063" rpy="0 0 0"/>
			<axis xyz="0 0 1"/>
			<!-- Servo hard limit minus 2 deg, inside BOTH sides' servo ranges (check_joint_limits.py). Was +-30 deg. -->
			<limit lower="-0.3455" upper="0.3455" effort="8.4" velocity="4.712388975"/>
		</joint>
		<link name="${side}Hip">
			<xacro:visuals_collisions_hip side="${side}"/>
			<inertial> <!-- Dummy values from Darwin OP -->
				<origin xyz="0.000000 0.000480 0.018437" />
				<mass value="0.167"/>
				<!-- Darwin-OP inertia scaled to kg*m^2 (source values were 1000x too large). Real HR-OS5 values: issue #32 -->
				<inertia ixx="0.000122597"  ixy="7.11275e-07"  ixz="8.11439e-07" iyx="7.11275e-07" iyy="0.000110666" iyz="-7.16355e-06" izx="8.11439e-07" izy="-7.16355e-06" izz="4.18777e-05" />
			</inertial>
		</link>
		<joint name="${side}HipRoll" type="revolute">
			<parent link="${side}Hip"/>
			<child link="${side}HipMotors"/>
			<origin xyz="-0.0675 0 -0.034" rpy="0 0 0"/>
			<axis xyz="1 0 0"/>
			<!-- Servo hard limit minus 2 deg. Outward is + on the left and - on the right; inward the servos allow
			     only ~5 deg, so -2.9..+45 deg (L) and -45..+2.9 deg (R). Was +-45 deg. -->
			<limit lower="${-0.785398163 if reflect == -1 else -0.0506}" upper="${0.785398163 if reflect == 1 else 0.0506}" effort="8.4" velocity="4.712388975"/>
		</joint>
		<link name="${side}HipMotors">
			<xacro:visuals_collisions_hip_motors side="${side}"/>
			<inertial> <!-- Dummy values from Darwin OP -->
				<origin xyz="0.000000 0.000480 0.018437" />
				<mass value="0.167"/>
				<!-- Darwin-OP inertia scaled to kg*m^2 (source values were 1000x too large). Real HR-OS5 values: issue #32 -->
				<inertia ixx="0.000122597"  ixy="7.11275e-07"  ixz="8.11439e-07" iyx="7.11275e-07" iyy="0.000110666" iyz="-7.16355e-06" izx="8.11439e-07" izy="-7.16355e-06" izz="4.18777e-05" />
			</inertial>
		</link>
		<joint name="${side}HipPitch" type="revolute">
			<parent link="${side}HipMotors"/>
			<child link="${side}Thigh"/>
			<origin xyz="0.0705 0 0" rpy="0 0 0"/>
			<axis xyz="0 1 0"/>
			<!-- Servo hard limit minus 2 deg, inside BOTH sides' servo ranges (check_joint_limits.py). Was +-90 deg. -->
			<limit lower="-1.5359" upper="0.5541" effort="8.4" velocity="4.712388975"/>
		</joint>
		<link name="${side}Thigh">
			<xacro:visuals_collisions_thigh side="${side}"/>
			<inertial> <!-- Dummy values from Darwin OP -->
				<origin xyz="0.000079 0.018242 0.013873" />
				<mass value="0.11904336"/>
				<!-- Darwin-OP inertia scaled to kg*m^2 (source values were 1000x too large). Real HR-OS5 values: issue #32 -->
				<inertia ixx="9.79503e-05"  ixy="1.21194e-06"  ixz="-2.1223e-07" iyx="1.22119e-06" iyy="3.28483e-05" iyz="-1.9474e-06" izx="-2.1223e-07" izy="-1.9474e-06" izz="0.000114935" />
			</inertial>
		</link>
		<joint name="${side}KneePitch" type="revolute">
			<parent link="${side}Thigh"/>
			<child link="${side}Tibia"/>
			<origin xyz="0.0017 0 -0.127" rpy="0 0 0"/>
			<axis xyz="0 1 0"/>
			<!-- Servo hard limit minus 2 deg, inside BOTH sides' servo ranges (check_joint_limits.py). Was +-160 deg. -->
			<limit lower="-0.3133" upper="2.1924" effort="8.4" velocity="4.712388975"/>
		</joint>
		<link name="${side}Tibia">
			<xacro:visuals_collisions_tibia side="${side}"/>
			<inertial> <!-- Dummy values from Darwin OP -->
				<origin xyz="-0.053955 0.006548 -0.000592" />
				<mass value="0.070309794"/>
				<!-- Darwin-OP inertia scaled to kg*m^2 (source values were 1000x too large). Real HR-OS5 values: issue #32 -->
				<inertia ixx="9.33696e-05"  ixy="-9.35674e-07"  ixz="-2.39921e-07" iyx="-9.35674e-07" iyy="4.62955e-05" iyz="-1.28585e-05" izx="-2.39921e-07" izy="-1.28585e-05" izz="0.000113515" />
			</inertial>
		</link>
		<joint name="${side}AnklePitch" type="revolute">
			<parent link="${side}Tibia"/>
			<child link="${side}Ankle"/>
			<origin xyz="-0.002 0 -0.125" rpy="0 0 0"/>
			<axis xyz="0 1 0"/>
			<!-- Servo hard limit minus 2 deg, inside BOTH sides' servo ranges (check_joint_limits.py). Was +-90 deg. -->
			<limit lower="-0.2796" upper="1.5359" effort="8.4" velocity="4.712388975"/>
		</joint>
		<link name="${side}Ankle">
			<xacro:visuals_collisions_ankle side="${side}"/>
			<inertial> <!-- Dummy values from Darwin OP -->
				<origin xyz="-0.000214 -0.018536 0.013873" />
				<mass value="0.16710792"/>
				<!-- Darwin-OP inertia scaled to kg*m^2 (source values were 1000x too large). Real HR-OS5 values: issue #32 -->
				<inertia ixx="0.000120792"  ixy="-7.97811e-07"  ixz="-3.93222e-07" iyx="-7.97811e-07" iyy="0.000108855" iyz="7.07701e-06" izx="-3.93222e-07" izy="7.07701e-06" izz="4.18711e-05" />
			</inertial>
		</link>
		<joint name="${side}AnkleRoll" type="revolute">
			<parent link="${side}Ankle"/>
			<child link="${side}Foot"/>
			<origin xyz="-0.07 0 0" rpy="0 0 0"/>
			<axis xyz="1 0 0"/>
			<limit lower="-0.785398163" upper="0.785398163" effort="8.4" velocity="4.712388975"/>
		</joint>
		<link name="${side}Foot">
			<xacro:visuals_collisions_foot side="${side}" reflect="${reflect}"/>
			<inertial> <!-- Dummy values from Darwin OP -->
				<origin xyz="-0.025995 -0.009506 -0.000503" />
				<mass value="0.0794462"/>
				<!-- Darwin-OP inertia scaled to kg*m^2 (source values were 1000x too large). Real HR-OS5 values: issue #32 -->
				<inertia ixx="0.000120792"  ixy="-7.97811e-07"  ixz="-3.93222e-07" iyx="-7.97811e-07" iyy="0.000108855" iyz="7.07701e-06" izx="-3.93222e-07" izy="7.07701e-06" izz="4.18711e-05" />
			</inertial>
		</link>
	</xacro:macro>

	<xacro:legs_links_joints reflect="1" side="L"/>
	<xacro:legs_links_joints reflect="-1" side="R"/>


<!-- ROS REP LINKS -->
	<joint name="l_ankle_joint" type="fixed">
		<parent link="LAnkle"/>
		<child link="l_ankle"/>
		<origin xyz="0 0 0" rpy="0 0 0"/>
	</joint>
	<link name="l_ankle"/>

	<joint name="r_ankle_joint" type="fixed">
		<parent link="RAnkle"/>
		<child link="r_ankle"/>
		<origin xyz="0 0 0" rpy="0 0 0"/>
	</joint>
	<link name="r_ankle"/>

	<joint name="l_sole_joint" type="fixed">
		<parent link="LFoot"/>
		<child link="l_sole"/>
		<origin xyz="0.0565 0.007 -0.04" rpy="0 0 0"/>
	</joint>
	<link name="l_sole"/>

	<joint name="r_sole_joint" type="fixed">
		<parent link="RFoot"/>
		<child link="r_sole"/>
		<origin xyz="0.0565 -0.007 -0.04" rpy="0 0 0"/>
	</joint>
	<link name="r_sole"/>
  
</robot>


