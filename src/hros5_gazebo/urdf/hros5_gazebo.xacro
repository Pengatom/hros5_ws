<?xml version="1.0"?>
<robot name="hros5_gazebo" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Full HR-OS5 model for Gazebo Harmonic with ros2_control simulation hardware -->

  <!-- Allow overriding the mesh bundle used for visuals/collisions -->
  <xacro:arg name="meshes_xacro_filename" default="$(find hros5_description)/urdf/hros5_visuals_collisions_endoskeleton.xacro"/>
  <xacro:arg name="controller_config" default="$(find hros5_gazebo)/config/hros5_controllers.yaml"/>
  <!-- fixed_base:=true pins base_link to the world (robot "on a stand"), useful for testing joints/controllers
       without balance. fixed_base:=false lets the robot stand freely on its feet. -->
  <xacro:arg name="fixed_base" default="false"/>

  <xacro:include filename="$(find hros5_description)/urdf/robot/robot.xacro"/>

  <xacro:if value="$(arg fixed_base)">
    <link name="world"/>
    <joint name="world_to_base" type="fixed">
      <parent link="world"/>
      <child link="base_link"/>
    </joint>
  </xacro:if>

  <!-- Bind Gazebo ros2_control to the simulated joints -->
  <ros2_control name="Hros5GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      <!-- Keep joints at their current position until a controller claims them,
           so the robot doesn't collapse between spawn and controller activation. -->
      <param name="hold_joints">true</param>
    </hardware>

    <joint name="HeadYaw">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="HeadPitch">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="LShoulderPitch">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="LShoulderRoll">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="LElbowPitch">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RShoulderPitch">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RShoulderRoll">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RElbowPitch">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="LHipYaw">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="LHipRoll">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="LHipPitch">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="LKneePitch">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="LAnklePitch">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="LAnkleRoll">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="RHipYaw">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RHipRoll">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RHipPitch">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RKneePitch">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RAnklePitch">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RAnkleRoll">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="LWrist">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="LGrip">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RWrist">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RGrip">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Load the Gazebo ros2_control system plugin with this controller file -->
  <gazebo>
    <!-- Plugin class name must match what's exported from libgz_ros2_control-system.so -->
    <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="libgz_ros2_control-system.so">
      <parameters>$(arg controller_config)</parameters>
    </plugin>
  </gazebo>

  <!-- IMU sensor on torso for balance/state estimation.
       The gz-sim Imu system that drives it is loaded in the world file (worlds/empty.world). -->
  <gazebo reference="torso">
    <sensor name="imu_sensor" type="imu">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>400</update_rate>
      <topic>imu</topic>
    </sensor>
  </gazebo>

  <!-- Foot contact surfaces: high friction so the feet don't slide while standing -->
  <gazebo reference="LFoot">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="RFoot">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <!-- Link colours for Gazebo. Gazebo loads the STL meshes, which have no colour, so everything
       was white. These blocks only affect Gazebo; RViz keeps the DAE mesh colours.
       Scheme: left side red, right side green (port/starboard). Links alternate dark/light
       along each limb, and servo/motor parts are near-black so the joints stand out. -->
  <xacro:macro name="gz_colour" params="link rgb">
    <gazebo reference="${link}">
      <visual>
        <material>
          <ambient>${rgb} 1</ambient>
          <diffuse>${rgb} 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </gazebo>
  </xacro:macro>

  <xacro:property name="c_torso" value="0.25 0.25 0.28"/>
  <xacro:property name="c_servo" value="0.12 0.12 0.12"/>
  <xacro:property name="c_head" value="0.20 0.45 0.85"/>
  <xacro:property name="c_head_light" value="0.85 0.85 0.85"/>
  <xacro:property name="c_left" value="0.80 0.12 0.12"/>
  <xacro:property name="c_left_light" value="0.95 0.55 0.55"/>
  <xacro:property name="c_left_dark" value="0.45 0.06 0.06"/>
  <xacro:property name="c_right" value="0.12 0.62 0.22"/>
  <xacro:property name="c_right_light" value="0.55 0.90 0.60"/>
  <xacro:property name="c_right_dark" value="0.05 0.35 0.12"/>

  <xacro:gz_colour link="torso" rgb="${c_torso}"/>
  <xacro:gz_colour link="LowerHead" rgb="${c_head_light}"/>
  <xacro:gz_colour link="UpperHeadBase" rgb="${c_head}"/>
  <xacro:gz_colour link="UpperHeadMotor" rgb="${c_servo}"/>
  <xacro:gz_colour link="UpperHeadBack" rgb="${c_head}"/>

  <!-- Arms: shoulder (servo) / upper arm / lower arm / forearm / hand / gripper -->
  <xacro:gz_colour link="LShoulder" rgb="${c_servo}"/>
  <xacro:gz_colour link="LUpperArm" rgb="${c_left}"/>
  <xacro:gz_colour link="LLowerArm" rgb="${c_left_light}"/>
  <xacro:gz_colour link="LForearm" rgb="${c_left}"/>
  <xacro:gz_colour link="LHand" rgb="${c_left_light}"/>
  <xacro:gz_colour link="LGripper" rgb="${c_servo}"/>
  <xacro:gz_colour link="RShoulder" rgb="${c_servo}"/>
  <xacro:gz_colour link="RUpperArm" rgb="${c_right}"/>
  <xacro:gz_colour link="RLowerArm" rgb="${c_right_light}"/>
  <xacro:gz_colour link="RForearm" rgb="${c_right}"/>
  <xacro:gz_colour link="RHand" rgb="${c_right_light}"/>
  <xacro:gz_colour link="RGripper" rgb="${c_servo}"/>

  <!-- Legs: hip (yaw) / hip motors (roll) / thigh / tibia / ankle / foot -->
  <xacro:gz_colour link="LHip" rgb="${c_left_dark}"/>
  <xacro:gz_colour link="LHipMotors" rgb="${c_servo}"/>
  <xacro:gz_colour link="LThigh" rgb="${c_left}"/>
  <xacro:gz_colour link="LTibia" rgb="${c_left_light}"/>
  <xacro:gz_colour link="LAnkle" rgb="${c_servo}"/>
  <xacro:gz_colour link="LFoot" rgb="${c_left_dark}"/>
  <xacro:gz_colour link="RHip" rgb="${c_right_dark}"/>
  <xacro:gz_colour link="RHipMotors" rgb="${c_servo}"/>
  <xacro:gz_colour link="RThigh" rgb="${c_right}"/>
  <xacro:gz_colour link="RTibia" rgb="${c_right_light}"/>
  <xacro:gz_colour link="RAnkle" rgb="${c_servo}"/>
  <xacro:gz_colour link="RFoot" rgb="${c_right_dark}"/>
</robot>
