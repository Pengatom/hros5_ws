<?xml version="1.0"?>
<package format="3">
  <name>hros5_gazebo</name>
  <version>0.0.1</version>
  <description>Gazebo simulation for H-ROS5</description>
  <maintainer email="Pengatom@example.com">Pengatom</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>gazebo_ros</depend>
  <depend>hros5_description</depend>
  <depend>hros5_control</depend>
  <depend>controller_manager</depend>
  <depend>ros_gz_bridge</depend>
  <depend>robot_state_publisher</depend>
  <depend>ros_gz_sim</depend>
  <depend>xacro</depend>
  <exec_depend>rqt_joint_trajectory_controller</exec_depend>
  <exec_depend>rqt_service_caller</exec_depend>
  <exec_depend>rclpy</exec_depend>
